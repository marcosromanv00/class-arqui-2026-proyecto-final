# Copie este archivo como .env.local y llene los valores (NO suba .env.local a GitHub).
# El portal funciona SIN estas variables:
#  - Sin Azure, la corrección ortográfica del directorio usa el corrector local (src/lib/corrector.ts).
#  - Sin Clarity, simplemente no se registra analítica.
# La llave de solo búsqueda de Algolia ya está en src/lib/directorio.ts (es pública por diseño).

# Azure OpenAI / Foundry (corrección de búsquedas, /api/corregir). Pida los valores a Allan por privado.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=

# Microsoft Clarity (solo para el sitio publicado)
NEXT_PUBLIC_CLARITY_ID=
